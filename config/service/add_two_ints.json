{
  "$schema": "../../schema/service-binding.schema.json",
  "version": 1,
  "service": {
    "transport_config": "add_two_ints-transport.json",
    "delta_time_usec": 1000,
    "time_source_type": "real"
  },
  "bindings": [
    {
      "ros_name": "/add_two_ints",
      "ros_type": "example_interfaces/srv/AddTwoInts",
      "hakoniwa_service": "Service/Add",
      "client_endpoint": {"node_id": "hakoniwa-pdu-ros-service"},
      "server_endpoint": {"node_id": "server_node"},
      "max_clients": 4,
      "timeout_msec": 3000
    }
  ]
}
