{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwalab.github.io/hakoniwa-pdu-ros/schema/action-binding.schema.json",
  "title": "Hakoniwa ROS 2 Action Bridge Binding",
  "description": "Direction-neutral binding between ROS 2 and Hakoniwa Actions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "action", "bindings"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "action": {"$ref": "#/$defs/action"},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport_config"],
      "properties": {
        "transport_config": {
          "type": "string",
          "minLength": 1,
          "description": "Hakoniwa Action transport object path, resolved relative to this binding file."
        },
        "delta_time_usec": {"type": "integer", "minimum": 1, "default": 1000},
        "time_source_type": {"type": "string", "minLength": 1, "default": "real"}
      }
    },
    "endpoint_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1}
      }
    },
    "heap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal_bytes": {"type": "integer", "minimum": 0},
        "result_bytes": {"type": "integer", "minimum": 0},
        "feedback_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ros_name",
        "ros_type",
        "hakoniwa_action",
        "client_endpoint",
        "server_endpoint",
        "slot_count",
        "goal_response_timeout_msec"
      ],
      "properties": {
        "ros_name": {
          "type": "string",
          "pattern": "^/[A-Za-z_][A-Za-z0-9_/]*$"
        },
        "ros_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*/action/[A-Za-z][A-Za-z0-9_]*$"
        },
        "hakoniwa_action": {"type": "string", "minLength": 1},
        "client_endpoint": {"$ref": "#/$defs/endpoint_ref"},
        "server_endpoint": {"$ref": "#/$defs/endpoint_ref"},
        "slot_count": {"type": "integer", "minimum": 1},
        "goal_response_timeout_msec": {"type": "integer", "minimum": 1},
        "heap": {"$ref": "#/$defs/heap"},
        "pdu_action_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*/[A-Za-z][A-Za-z0-9_]*$"
        }
      }
    }
  }
}
