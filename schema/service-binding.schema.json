{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hakoniwalab.github.io/hakoniwa-pdu-ros/schema/service-binding.schema.json",
  "title": "Hakoniwa ROS 2 Service Bridge Binding",
  "description": "Direction-neutral configuration shared by the ROS Service Server and Client bridge nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "service", "bindings"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "service": {
      "$ref": "#/$defs/service"
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    }
  },
  "$defs": {
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport_config"],
      "properties": {
        "transport_config": {
          "type": "string",
          "minLength": 1,
          "description": "Hakoniwa Service transport object path, resolved relative to this binding file."
        },
        "delta_time_usec": {
          "type": "integer",
          "minimum": 1,
          "default": 1000
        },
        "time_source_type": {
          "type": "string",
          "minLength": 1,
          "default": "real"
        }
      }
    },
    "endpoint_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id"],
      "properties": {
        "node_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "heap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_bytes": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "response_bytes": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ros_name",
        "ros_type",
        "hakoniwa_service",
        "client_endpoint",
        "server_endpoint",
        "max_clients",
        "timeout_msec"
      ],
      "properties": {
        "ros_name": {
          "type": "string",
          "pattern": "^/[A-Za-z_][A-Za-z0-9_/]*$",
          "description": "Absolute ROS 2 service name exposed or called by the selected bridge entry point."
        },
        "ros_type": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*/srv/[A-Za-z][A-Za-z0-9_]*$",
          "description": "ROS 2 service interface in package/srv/Type form. The installed .srv definition is the IDL source."
        },
        "hakoniwa_service": {
          "type": "string",
          "minLength": 1,
          "description": "Service name generated into the PDU-RPC service configuration."
        },
        "client_endpoint": {
          "$ref": "#/$defs/endpoint_ref",
          "description": "Logical PDU-RPC client endpoint."
        },
        "server_endpoint": {
          "$ref": "#/$defs/endpoint_ref",
          "description": "Logical PDU-RPC server endpoint."
        },
        "max_clients": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum concurrent clients for this service. Client names are generated automatically."
        },
        "timeout_msec": {
          "type": "integer",
          "minimum": 1,
          "description": "Bridge-side RPC timeout in milliseconds."
        },
        "heap": {
          "$ref": "#/$defs/heap"
        },
        "pdu_service_type": {
          "type": "string",
          "minLength": 1,
          "description": "Optional generated PDU service type override. Normally resolved from ros_type."
        }
      }
    }
  }
}
